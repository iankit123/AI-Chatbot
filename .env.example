# Get your free API key from https://console.groq.com/keys
GROQ_API_KEY="YOUR_API_KEY_HERE"

# Meta Conversions API (server-side Purchase and payment_attempted events).
# Events Manager → pixel 1838700220429198 → Settings → Conversions API → Generate access token.
# Leave empty to turn server events off (the browser Pixel still works).
META_CAPI_ACCESS_TOKEN=
# Optional: code from Events Manager → Test events, to check server events. Remove after testing.
META_CAPI_TEST_EVENT_CODE=
